{
  "id": "banker-algorithm",
  "title": "银行家算法（安全性检查 + 安全序列）",
  "kind": "deterministic",
  "entry": "solve",
  "arg_names": ["available", "max_need", "allocation"],
  "compare": "exact",
  "tol": 1e-6,
  "cases": [
    {
      "name": "用例1：408 经典数据（安全，序列 1,3,0,2,4）",
      "input": {
        "available": [3, 3, 2],
        "max_need": [[7, 5, 3], [3, 2, 2], [9, 0, 2], [2, 2, 2], [4, 3, 3]],
        "allocation": [[0, 1, 0], [2, 0, 0], [3, 0, 2], [2, 1, 1], [0, 0, 2]]
      },
      "expected": {"safe": true, "sequence": [1, 3, 0, 2, 4]}
    },
    {
      "name": "用例2：两进程均安全（序列 0,1）",
      "input": {
        "available": [2, 1, 1],
        "max_need": [[2, 1, 1], [1, 2, 1]],
        "allocation": [[1, 0, 0], [0, 1, 0]]
      },
      "expected": {"safe": true, "sequence": [0, 1]}
    },
    {
      "name": "用例3：三进程安全（序列 0,1,2）",
      "input": {
        "available": [2, 2, 2],
        "max_need": [[2, 2, 2], [1, 1, 1], [3, 3, 3]],
        "allocation": [[1, 1, 1], [1, 1, 1], [1, 1, 1]]
      },
      "expected": {"safe": true, "sequence": [0, 1, 2]}
    },
    {
      "name": "用例4：两进程互相等待，不安全（sequence=[]）",
      "input": {
        "available": [1, 0],
        "max_need": [[1, 1], [1, 1]],
        "allocation": [[1, 0], [1, 0]]
      },
      "expected": {"safe": false, "sequence": []}
    },
    {
      "name": "用例5：小下标进程阻塞、较大下标可完成，不安全（前缀 [1]）",
      "input": {
        "available": [0, 0],
        "max_need": [[1, 0], [0, 0]],
        "allocation": [[0, 0], [0, 0]]
      },
      "expected": {"safe": false, "sequence": [1]}
    },
    {
      "name": "用例6：单进程系统安全（序列 0）",
      "input": {
        "available": [1, 1, 1],
        "max_need": [[1, 1, 1]],
        "allocation": [[0, 0, 0]]
      },
      "expected": {"safe": true, "sequence": [0]}
    }
  ]
}
